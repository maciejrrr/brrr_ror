<% content_for :title, "Forgot Password · Brrr" %>

<div class="max-w-md mx-auto mt-12 p-8 rounded-2xl border border-zinc-800 bg-zinc-900/60 shadow-xl space-y-6">
  <div>
    <h1 class="text-xl font-bold text-white">Reset your password</h1>
    <p class="mt-1 text-xs text-zinc-400">
      Enter your email address to receive password reset instructions.
    </p>
  </div>

  <%= form_with url: passwords_path, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :email_address, "Email address", class: "block text-xs font-medium text-zinc-300 mb-1" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "demo@example.com", value: params[:email_address], class: "w-full rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2 text-sm text-white placeholder-zinc-500 focus:border-emerald-500 focus:outline-none" %>
    </div>

    <div class="pt-2 flex items-center justify-between">
      <%= link_to "Back to sign in", new_session_path, class: "text-xs text-zinc-400 hover:text-zinc-200 transition" %>
      <%= form.submit "Send reset email", class: "cursor-pointer py-2 px-4 text-sm font-semibold rounded-lg bg-emerald-500 text-zinc-950 hover:bg-emerald-400 transition shadow-sm" %>
    </div>
  <% end %>
</div>
