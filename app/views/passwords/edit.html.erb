<% content_for :title, "Update Password · Brrr" %>

<div class="max-w-md mx-auto mt-12 p-8 rounded-2xl border border-zinc-800 bg-zinc-900/60 shadow-xl space-y-6">
  <div>
    <h1 class="text-xl font-bold text-white">Update your password</h1>
    <p class="mt-1 text-xs text-zinc-400">
      Choose a secure password for your research account.
    </p>
  </div>

  <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :password, "New password", class: "block text-xs font-medium text-zinc-300 mb-1" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "••••••••", maxlength: 72, class: "w-full rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2 text-sm text-white placeholder-zinc-500 focus:border-emerald-500 focus:outline-none" %>
    </div>

    <div>
      <%= form.label :password_confirmation, "Confirm new password", class: "block text-xs font-medium text-zinc-300 mb-1" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "••••••••", maxlength: 72, class: "w-full rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2 text-sm text-white placeholder-zinc-500 focus:border-emerald-500 focus:outline-none" %>
    </div>

    <div class="pt-2 flex items-center justify-between">
      <%= link_to "Back to sign in", new_session_path, class: "text-xs text-zinc-400 hover:text-zinc-200 transition" %>
      <%= form.submit "Save new password", class: "cursor-pointer py-2 px-4 text-sm font-semibold rounded-lg bg-emerald-500 text-zinc-950 hover:bg-emerald-400 transition shadow-sm" %>
    </div>
  <% end %>
</div>
