<% content_for :title, "Sign In · Brrr" %>

<div class="max-w-md mx-auto mt-12 p-8 rounded-2xl border border-zinc-800 bg-zinc-900/60 shadow-xl space-y-6">
  <div>
    <div class="flex items-center gap-2 text-emerald-400 font-mono font-bold text-2xl tracking-tight">
      <span class="inline-block w-3 h-3 rounded-full bg-emerald-500"></span>
      brrr
    </div>
    <h1 class="mt-4 text-xl font-bold text-white">Sign in to your research workspace</h1>
    <p class="mt-1 text-xs text-zinc-400">
      Access your saved backtests, market data series, and historical analytics.
    </p>
  </div>

  <%= form_with url: session_url, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :email_address, "Email address", class: "block text-xs font-medium text-zinc-300 mb-1" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "demo@example.com", value: params[:email_address], class: "w-full rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2 text-sm text-white placeholder-zinc-500 focus:border-emerald-500 focus:outline-none" %>
    </div>

    <div>
      <div class="flex items-center justify-between mb-1">
        <%= form.label :password, "Password", class: "block text-xs font-medium text-zinc-300" %>
        <%= link_to "Forgot password?", new_password_path, class: "text-xs text-zinc-500 hover:text-zinc-300 transition" %>
      </div>
      <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "••••••••", maxlength: 72, class: "w-full rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2 text-sm text-white placeholder-zinc-500 focus:border-emerald-500 focus:outline-none" %>
    </div>

    <div class="pt-2">
      <%= form.submit "Sign in", class: "w-full cursor-pointer py-2.5 px-4 text-sm font-semibold rounded-lg bg-emerald-500 text-zinc-950 hover:bg-emerald-400 transition shadow-sm" %>
    </div>
  <% end %>

  <div class="p-3.5 rounded-lg border border-zinc-800 bg-zinc-950/60 text-xs text-zinc-400 space-y-1">
    <div class="font-semibold text-zinc-300">Demo Credentials:</div>
    <div class="font-mono text-zinc-400">Email: <span class="text-emerald-400">demo@example.com</span></div>
    <div class="font-mono text-zinc-400">Password: <span class="text-emerald-400">password123</span></div>
  </div>
</div>
