<% content_for :title, "Backtests · Brrr" %>

<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-white">Backtest Runs</h1>
      <p class="mt-1 text-sm text-zinc-400">
        Your library of reproducible, long-only quantitative backtest results.
      </p>
    </div>
    <%= link_to new_backtest_run_path, class: "inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold rounded-lg bg-emerald-500 text-zinc-950 hover:bg-emerald-400 transition shadow-sm" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
      New Backtest
    <% end %>
  </div>

  <!-- Filters -->
  <div class="p-4 rounded-xl border border-zinc-800 bg-zinc-900/40 flex flex-wrap items-center gap-4 text-xs">
    <span class="text-zinc-500 uppercase tracking-wider font-semibold">Filters:</span>

    <div class="flex items-center gap-1.5">
      <%= link_to "All", backtest_runs_path, class: "px-2.5 py-1 rounded-md transition #{params[:status].blank? && params[:strategy_key].blank? ? 'bg-zinc-800 text-white' : 'text-zinc-400 hover:text-zinc-200'}" %>
      <% BacktestRun.statuses.keys.each do |status| %>
        <%= link_to status.capitalize, backtest_runs_path(status: status, strategy_key: params[:strategy_key], asset_id: params[:asset_id]), class: "px-2.5 py-1 rounded-md transition #{params[:status] == status ? 'bg-zinc-800 text-white' : 'text-zinc-400 hover:text-zinc-200'}" %>
      <% end %>
    </div>
  </div>

  <!-- Runs Table -->
  <div class="rounded-xl border border-zinc-800 bg-zinc-900/40 overflow-hidden">
    <% if @runs.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-zinc-300">
          <thead class="border-b border-zinc-800 text-xs uppercase font-medium text-zinc-500 bg-zinc-900/80">
            <tr>
              <th class="py-3.5 px-4">Status</th>
              <th class="py-3.5 px-4">Strategy & Label</th>
              <th class="py-3.5 px-4">Asset</th>
              <th class="py-3.5 px-4">Interval</th>
              <th class="py-3.5 px-4 text-right">Return</th>
              <th class="py-3.5 px-4 text-right">CAGR</th>
              <th class="py-3.5 px-4 text-right">Max DD</th>
              <th class="py-3.5 px-4 text-right">Sharpe</th>
              <th class="py-3.5 px-4 text-right">Trades</th>
              <th class="py-3.5 px-4 text-right">Win Rate</th>
              <th class="py-3.5 px-4 text-right">Executed</th>
              <th class="py-3.5 px-4 text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-800/60">
            <% @runs.each do |run| %>
              <tr class="hover:bg-zinc-800/30 transition">
                <td class="py-3.5 px-4">
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium border <%= status_badge_class(run.status) %>">
                    <%= run.status.capitalize %>
                  </span>
                </td>
                <td class="py-3.5 px-4">
                  <div class="font-medium text-zinc-200"><%= run.strategy_key.humanize %></div>
                  <% if run.label.present? %>
                    <div class="text-xs text-zinc-500 truncate max-w-xs"><%= run.label %></div>
                  <% end %>
                </td>
                <td class="py-3.5 px-4 font-mono font-bold text-white"><%= run.asset.symbol %></td>
                <td class="py-3.5 px-4 text-xs text-zinc-400"><%= run.interval.humanize %></td>
                <td class="py-3.5 px-4 text-right font-mono font-semibold <%= return_color_class(run.total_return_percentage) %>">
                  <%= run.completed? ? format_percentage(run.total_return_percentage) : "—" %>
                </td>
                <td class="py-3.5 px-4 text-right font-mono text-zinc-300">
                  <%= run.completed? ? format_percentage(run.cagr_percentage) : "—" %>
                </td>
                <td class="py-3.5 px-4 text-right font-mono text-rose-400">
                  <%= run.completed? ? format_percentage(run.maximum_drawdown_percentage) : "—" %>
                </td>
                <td class="py-3.5 px-4 text-right font-mono text-zinc-300">
                  <%= run.completed? ? format_ratio(run.sharpe_ratio) : "—" %>
                </td>
                <td class="py-3.5 px-4 text-right font-mono text-zinc-300">
                  <%= run.completed? ? run.trade_count : "—" %>
                </td>
                <td class="py-3.5 px-4 text-right font-mono text-zinc-300">
                  <%= run.completed? ? "#{run.win_rate_percentage&.round(1)}%" : "—" %>
                </td>
                <td class="py-3.5 px-4 text-right text-xs font-mono text-zinc-500">
                  <%= format_utc(run.created_at, format: :short) %>
                </td>
                <td class="py-3.5 px-4 text-right whitespace-nowrap">
                  <%= link_to "View", backtest_run_path(run), class: "text-xs font-medium text-emerald-400 hover:text-emerald-300 transition mr-3" %>
                  <%= button_to "Delete", backtest_run_path(run), method: :delete, data: { turbo_confirm: "Delete this backtest run?" }, class: "inline text-xs text-zinc-500 hover:text-rose-400 transition cursor-pointer" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-16">
        <p class="text-zinc-400 text-sm">No backtests found matching criteria.</p>
        <%= link_to "Launch a new backtest", new_backtest_run_path, class: "mt-3 inline-block text-xs font-semibold text-emerald-400 hover:text-emerald-300" %>
      </div>
    <% end %>
  </div>
</div>
